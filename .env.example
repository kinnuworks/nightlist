# Leave SAMPLE_MODE=true to run everything locally with no accounts (DuckDB runs the
# same semantic-layer SQL that Zetaris runs in live mode).
SAMPLE_MODE=true
PORT=8787

# Zetaris (live mode). Local install in Docker: REST on port 8888, organisation ID 1.
# From a container, use host.docker.internal instead of localhost. See docs/SETUP.md.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_ORG_ID=1
ZETARIS_USL_NAMESPACE=lightning.metastore.nightlist
ZETARIS_USL=trialmatch
# Where the Zetaris container sees this repo's data folder, for file-store tables.
ZETARIS_FILE_ROOT=file:///opt/nightlist/data
EHR_JDBC_URL=jdbc:postgresql://host.docker.internal:5433/ehr
EHR_DB_USER=nightlist
EHR_DB_PASSWORD=nightlist

# Meterless Nightshift (primary AI provider). Copy the Runtime URL and API key from
# Nightshift's Console. The older NIGHTSHIFT_URL / NIGHTSHIFT_TOKEN / NIGHTSHIFT_TOKEN_FILE
# names still work; these official names win when both are set.
# Your NVIDIA key goes in Nightshift's Setup > Providers tab, never in this file.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
# Route for the Compiler (rules it cannot handle go to the model). Pin a Nemotron-backed
# route so the trace shows Nemotron did the work; meterless/auto may pick another model.
METERLESS_MODEL=meterless/deep
# Route for the Checker's back-translation.
NIGHTSHIFT_CHECK_MODEL=meterless/fast
